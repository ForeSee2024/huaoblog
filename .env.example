# 正式站点地址，影响 canonical 和 CMS 站点链接。
SITE_URL=https://huaoblog.cn

# 后台通过本站 API 直接读写内容，GitHub 仅用于登录身份验证。
CMS_BACKEND=api
CMS_REPO=ForeSee2024/huaoblog
CMS_AUTH_URL=https://huaoblog-oauth.huaoqaq.workers.dev
ADMIN_GITHUB_ID=160737293
# Node 自有服务器的持久数据目录（不是网站静态目录）。
APP_DATA_DIR=/var/lib/huaoblog
HOST=127.0.0.1
PORT=4321
# APP_DEV_AUTH=1 仅用于本机临时测试；正式服务器不要设置。
