---
// BaseLayout.astro: 全站通用基础布局
import ThemeScript from '../components/common/ThemeScript.astro';
import ThreeWaveBg from '../components/common/ThreeWaveBg.astro';
import HeaderNav from '../components/layout/HeaderNav.astro';
import SearchModal from '../components/common/SearchModal.astro';
import Toast from '../components/common/Toast.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { safeExternalHref, settings, site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title = site.name,
  description = site.description,
  fullWidth = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonical = Astro.site ? new URL(currentPath, Astro.site) : undefined;
const renderThree = settings.appearance.backgroundEffect;
const icpHref = safeExternalHref(settings.footer.icpUrl);
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme={settings.appearance.theme === 'light' ? 'light' : 'dark'} data-accent={settings.appearance.accent}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={currentPath.startsWith('/posts/') ? 'article' : 'website'} />

  <!-- 免闪烁系统自适应深浅主题与强调色探测 -->
  <ThemeScript />

  <!-- 现代字体体系与专业矢量图标库 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={site.fonts} rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="selection:bg-[var(--accent)] selection:text-[var(--accent-contrast)]">
  
  <!-- 辅助工程网格层与 Three.js 3D 拓扑波浪画布 -->
  <div class="bg-grid-layer"></div>
  {renderThree && <ThreeWaveBg />}

  <!-- 顶部悬浮胶囊导航 -->
  <div data-pagefind-ignore>
    <HeaderNav currentPath={currentPath} />
  </div>

  <!-- 主体工作区容器 -->
  <div class:list={['relative z-10 pt-24 pb-16 min-h-screen', { 'max-w-7xl mx-auto px-4': !fullWidth }]}>
    <slot />
  </div>

  <!-- 全局检索模态框与通知 Toast -->
  <SearchModal />
  <Toast />

  <!-- 极客页脚 -->
  <footer data-pagefind-ignore class="relative z-10 text-center py-8 border-t border-[var(--border-subtle)] text-xs text-[var(--text-dim)]">
    <p class="mb-1.5 font-medium">{site.name}{settings.footer.text && <> · {settings.footer.text}</>}</p>
    <p>© {new Date().getFullYear()} {site.author} · <a href="/admin/" class="hover:text-[var(--accent)]">管理后台</a></p>
    {settings.footer.icp && <p class="mt-2">{icpHref ? <a href={icpHref} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)]">{settings.footer.icp}</a> : settings.footer.icp}</p>}
  </footer>

</body>
</html>
