---
// BaseLayout.astro: 全站通用基础布局
import ThemeScript from '../components/common/ThemeScript.astro';
import ThreeWaveBg from '../components/common/ThreeWaveBg.astro';
import HeaderNav from '../components/layout/HeaderNav.astro';
import SearchModal from '../components/common/SearchModal.astro';
import Toast from '../components/common/Toast.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { safeExternalHref, siteFor } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  analyticsTarget?: { type: 'post' | 'page'; key: string } | false;
  wideStage?: boolean;
}

const settings = Astro.locals.siteSettings;
const site = siteFor(settings);
const {
  title = site.name,
  description = site.description,
  analyticsTarget,
  wideStage = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/+$/, '') || '/';
const knownPublicPages = new Set(['/', '/posts', '/archive', '/about', '/friends']);
const analytics = analyticsTarget === false
  ? null
  : analyticsTarget || (knownPublicPages.has(normalizedPath) ? { type: 'page', key: normalizedPath } : null);
const canonical = Astro.site ? new URL(currentPath, Astro.site) : undefined;
const renderThree = settings.appearance.backgroundEffect;
const icpHref = safeExternalHref(settings.footer.icpUrl);
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme={settings.appearance.theme === 'light' ? 'light' : 'dark'} data-accent={settings.appearance.accent}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={currentPath.startsWith('/posts/') ? 'article' : 'website'} />

  <!-- 免闪烁系统自适应深浅主题与强调色探测 -->
  <ThemeScript />

  <!-- 现代字体体系与专业矢量图标库 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={site.fonts} rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body
  class="selection:bg-[var(--accent)] selection:text-[var(--accent-contrast)]"
  data-analytics-type={analytics?.type}
  data-analytics-key={analytics?.key}
>
  <a href="#page-main-workspace" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[80] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--accent)] focus:text-[var(--accent-contrast)] focus:font-bold focus:text-xs">跳到正文内容</a>

  <!-- 极光环境层、纳米工程网格层与 Three.js 3D 拓扑波浪画布 -->
  <div class="bg-aurora-layer" aria-hidden="true"></div>
  <div class="bg-grid-layer" aria-hidden="true"></div>
  {renderThree && <ThreeWaveBg />}

  <!-- 顶部悬浮胶囊导航 -->
  <div data-pagefind-ignore>
    <HeaderNav currentPath={currentPath} />
  </div>

  <!-- 主体工作区容器 -->
  <div id="page-main-workspace" class:list={['relative z-10 pt-24 pb-16 min-h-screen mx-auto px-4 sm:px-6', wideStage ? 'max-w-[92rem]' : 'max-w-7xl']}>
    <slot />
  </div>

  <!-- 悬浮回到顶部按钮 -->
  <button type="button" id="btn-back-to-top" class="back-to-top-btn" aria-label="回到页面顶部" title="回到顶部">
    <i class="fa-solid fa-arrow-up text-xs" aria-hidden="true"></i>
  </button>

  <!-- 全局检索模态框与通知 Toast -->
  <SearchModal />
  <Toast />

  <!-- 极客页脚 -->
  <footer data-pagefind-ignore class="relative z-10 text-center py-9 border-t border-[var(--border-subtle)] text-xs text-[var(--text-dim)]">
    <p class="mb-1.5 font-semibold text-[var(--text-muted)]">{site.name}{settings.footer.text && <> · {settings.footer.text}</>}</p>
    <p>© {new Date().getFullYear()} {site.author} · <a href="/archive" class="hover:text-[var(--accent)] transition-colors">文章归档</a> · <a href="/admin/" class="hover:text-[var(--accent)] transition-colors">管理后台</a></p>
    {settings.footer.icp && <p class="mt-2">{icpHref ? <a href={icpHref} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)] transition-colors">{settings.footer.icp}</a> : settings.footer.icp}</p>}
  </footer>

  <script>
    import { startReadingTracker } from '../lib/reading-tracker.js';
    startReadingTracker();

    const topBtn = document.getElementById('btn-back-to-top');
    if (topBtn) {
      const toggleTopBtn = () => topBtn.classList.toggle('is-visible', window.scrollY > 420);
      window.addEventListener('scroll', toggleTopBtn, { passive: true });
      toggleTopBtn();
      topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }
  </script>
</body>
</html>
