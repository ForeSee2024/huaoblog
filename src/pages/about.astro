---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import ProfileBadge from '../components/common/ProfileBadge.astro';
import ProfileIcon from '../components/common/ProfileIcon.astro';
import { settings, site, safeExternalHref, safeImageSrc } from '../config/site';
import { renderMarkdownPreview } from '../lib/markdown-preview.js';
import { loadGitHubProfile } from '../lib/github-profile.js';
import githubSnapshot from '../data/github-profile.json';
import '../styles/about.css';

const { about } = settings;
const body = renderMarkdownPreview(about.body);
const cover = safeImageSrc(about.coverImage || '');
const avatar = safeImageSrc(site.avatar) || '/favicon.svg';
const socials = site.socialLinks.filter(link => safeExternalHref(link.url));
const github = socials.find(link => {
  const url = new URL(link.url);
  return url.protocol === 'https:' && url.hostname === 'github.com' && /^\/[a-zA-Z0-9-]+\/?$/.test(url.pathname);
});
const githubName = github && new URL(github.url).pathname.replaceAll('/', '');
const showGithub = about.githubEnabled !== false && githubName;
const stats = showGithub ? await loadGitHubProfile(githubName, githubSnapshot) : undefined;
const systemNames = { macos: 'macOS', windows: 'Windows', linux: 'Linux' };
const systems = (about.operatingSystems || []).filter(key => key in systemNames);
const languages = stats?.languages || [];
const colors: Record<string, string> = { CSS: '#a78bfa', JavaScript: '#facc15', TypeScript: '#60a5fa', Python: '#34d399', HTML: '#fb923c', Rust: '#f87171' };
---
<BaseLayout title={`${about.title} | ${site.brand}`} description={site.description}>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <Sidebar />
    <main class="about-page w-full lg:flex-1 min-w-0 order-1 lg:order-2">
      <article class="cyber-card about-document">
        <header class:list={['about-header', { 'about-header-covered': cover }]}>
          {cover && <img class="about-cover" src={cover} alt="" fetchpriority="high" />}
          <div class="about-heading">
            <nav class="about-breadcrumb" aria-label="当前位置"><a href="/">HOME</a><span aria-hidden="true">/</span><span>ABOUT ME</span></nav>
            <h1>{about.title}</h1>
            {about.subtitle && <p>{about.subtitle}</p>}
          </div>
        </header>

        <div class="about-document-body">
          <section class="about-introduction" aria-label="个人介绍">
            <img class="about-avatar" src={avatar} alt={`${site.author}的头像`} width="280" height="280" />
            <h2>{about.introduction || site.author}</h2>
            {about.languages && <p class="about-languages">{about.languages}</p>}
          </section>

          {about.body && <div class="article-prose about-prose" set:html={body}></div>}
          <ul class="about-contact-list" aria-label="博客与联系方式">
            <li><span>Blog | 博客：</span><a href="/">{Astro.site?.origin || site.brand}</a></li>
            {socials.map(link => <li><span>{link.label}：</span><a href={link.url} target="_blank" rel="noopener noreferrer">{link.url}<ProfileIcon name="arrow" /></a></li>)}
          </ul>

          {systems.length > 0 && <section class="about-section" aria-labelledby="systems-title">
            <h2 id="systems-title">My Operating Systems <span aria-hidden="true">|</span> 个人用系统</h2>
            <ul class="about-icon-row" aria-label="个人使用的操作系统">
              {systems.map(key => <ProfileBadge name={systemNames[key]} icon={key} />)}
            </ul>
          </section>}

          {(about.tools || []).length > 0 && <section class="about-section" aria-labelledby="skills-title">
            <h2 id="skills-title">My Skill Set <span aria-hidden="true">|</span> 技能与工具</h2>
            <ul class="about-icon-row" aria-label="技能与工具">
              {about.tools!.map(tool => <ProfileBadge {...tool} />)}
            </ul>
          </section>}

          {showGithub && <section class="about-section" aria-labelledby="github-title">
            <h2 id="github-title">GitHub Stats <span aria-hidden="true">|</span> GitHub 详情</h2>
            {stats ? <>
              <div class="about-github-stats">
                <div class="about-stat-panel">
                  <h3><ProfileIcon name="github" />{stats.username}'s GitHub Stats</h3>
                  <dl class="about-stat-list">
                    <div><dt>Public Repositories</dt><dd>{stats.publicRepos}</dd></div>
                    <div><dt>Stars Earned</dt><dd>{stats.stars}</dd></div>
                    <div><dt>Followers</dt><dd>{stats.followers}</dd></div>
                    <div><dt>Following</dt><dd>{stats.following}</dd></div>
                  </dl>
                </div>
                <div class="about-stat-panel">
                  <h3>Most Used Languages</h3>
                  {languages.length > 0 ? <>
                    <div class="about-language-bar" aria-hidden="true">{languages.map(language => <span style={`width:${language.count / stats.languageRepos * 100}%;background:${colors[language.name] || 'var(--accent)'}`} />)}</div>
                    <ul class="about-language-list">{languages.map(language => <li><span class="about-language-dot" style={`background:${colors[language.name] || 'var(--accent)'}`} aria-hidden="true" /><span>{language.name}</span><span>{Math.round(language.count / stats.languageRepos * 100)}%</span></li>)}</ul>
                  </> : <p class="about-stat-empty">暂无公开仓库的语言数据。</p>}
                </div>
              </div>
              <p class="about-stats-note">公开资料 · 更新于 <time datetime={stats.updatedAt}>{stats.updatedAt.slice(0, 10)}</time>。Star 与语言按{stats.publicRepos > stats.repositorySample ? '最近更新的 100 个' : ''}公开原创仓库统计，语言比例按仓库数量计算。</p>
            </> : <p class="about-stat-empty">GitHub 统计暂时无法读取，可以直接查看个人主页。</p>}
            <a class="about-github-link" href={github!.url} target="_blank" rel="noopener noreferrer">GitHub · @{githubName}<ProfileIcon name="arrow" /></a>
          </section>}
        </div>
      </article>
    </main>
  </div>
</BaseLayout>
