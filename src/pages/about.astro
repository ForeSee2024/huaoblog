---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import { categories, settings, site } from '../config/site';
import { renderMarkdownPreview } from '../lib/markdown-preview.js';
const body = renderMarkdownPreview(settings.about.body);
---
<BaseLayout title={`关于 ${site.author} | ${site.name}`}>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <Sidebar />
    <main class="w-full lg:flex-1 flex flex-col gap-6 min-w-0 order-1 lg:order-2">
      <section class="cyber-card p-6 md:p-10">
        <p class="font-mono text-xs text-[var(--accent)] mb-4">ABOUT / {site.brand}</p>
        <h1 class="text-3xl md:text-5xl font-extrabold text-[var(--text-hero)] mb-3">{settings.about.title}</h1>
        {settings.about.subtitle && <p class="text-lg text-[var(--text-muted)] mb-6">{settings.about.subtitle}</p>}
        <div class="article-prose" set:html={body}></div>
      </section>
      <section class="cyber-card p-6 md:p-8">
        <h2 class="text-xl font-bold text-[var(--text-hero)] mb-4">我在这里记录什么</h2>
        <p class="text-sm text-[var(--text-muted)] leading-loose mb-5">文章按一个主要主题归类，交叉内容用标签联系起来，连续的探索放进同一个系列。</p>
        <div class="flex flex-col divide-y divide-[var(--border-subtle)]">{categories.map((category, index) => <a href={`/posts?cat=${encodeURIComponent(category)}`} class="flex items-center gap-4 py-4 no-underline group"><span class="font-mono text-xs text-[var(--accent)]">0{index + 1}</span><span class="text-sm text-[var(--text-main)] group-hover:text-[var(--accent)]">{category}</span></a>)}</div>
      </section>
    </main>
  </div>
</BaseLayout>
