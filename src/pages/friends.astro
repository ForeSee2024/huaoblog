---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import { safeExternalHref, safeImageSrc, settings, site } from '../config/site';
const home = Astro.site?.href;
const friends = settings.friends.flatMap(friend => {
  const url = safeExternalHref(friend.url);
  return url ? [{ ...friend, url, avatar: friend.avatar ? safeImageSrc(friend.avatar) : undefined }] : [];
});
---
<BaseLayout title={`友链 | ${site.name}`}>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <Sidebar />
    <main class="w-full lg:flex-1 flex flex-col gap-6 min-w-0 order-1 lg:order-2">
      <header class="cyber-card p-6 md:p-8">
        <p class="text-xs font-mono text-[var(--accent)] mb-3">CONNECTIONS / FRIENDS</p>
        <h1 class="text-3xl font-extrabold text-[var(--text-hero)] mb-3">伙伴与友链</h1>
        <p class="text-sm text-[var(--text-muted)] leading-loose">这里将收录朋友们的博客与值得长期阅读的独立网站。</p>
      </header>
      {friends.length > 0 ? <section class="cyber-card p-6 md:p-8" aria-label="友链列表">
        <div class="flex flex-col divide-y divide-[var(--border-subtle)]">
          {friends.map(friend => <a href={friend.url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 py-5 first:pt-0 last:pb-0 no-underline group">
            {friend.avatar ? <img src={friend.avatar} alt="" loading="lazy" class="w-12 h-12 object-cover rounded-xl flex-shrink-0" /> : <span class="w-12 h-12 rounded-xl bg-[var(--accent-soft)] text-[var(--accent)] flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-link" aria-hidden="true"></i></span>}
            <span class="min-w-0 flex-1">
              <span class="block text-base font-bold text-[var(--text-hero)] group-hover:text-[var(--accent)] transition-colors">{friend.name}</span>
              <span class="block text-sm text-[var(--text-muted)] leading-relaxed whitespace-pre-line mt-1">{friend.description}</span>
            </span>
            <i class="fa-solid fa-arrow-up-right-from-square text-xs text-[var(--text-dim)] mt-1" aria-hidden="true"></i>
          </a>)}
        </div>
      </section> : <section class="cyber-card p-8 md:p-10">
        <h2 class="text-lg font-bold text-[var(--text-hero)] mb-3">友链正在整理</h2>
        <p class="text-sm text-[var(--text-muted)] leading-loose">目前还没有添加正式友链。你可以先浏览我的文章，或看看最近的归档。</p>
        <a href="/archive" class="inline-block mt-5 text-sm text-[var(--accent)]">查看文章归档 →</a>
      </section>}
      <section class="cyber-card p-6 md:p-8">
        <h2 class="text-lg font-bold text-[var(--text-hero)] mb-4">本站信息</h2>
        <dl class="grid grid-cols-[4rem_1fr] gap-x-4 gap-y-3 text-sm"><dt class="text-[var(--text-muted)]">名称</dt><dd>{site.brand}</dd><dt class="text-[var(--text-muted)]">作者</dt><dd>{site.author}</dd><dt class="text-[var(--text-muted)]">简介</dt><dd>{site.description}</dd>{home && <><dt class="text-[var(--text-muted)]">主页</dt><dd class="break-all"><a href={home} class="text-[var(--accent)]">{home}</a></dd></>}</dl>
      </section>
    </main>
  </div>
</BaseLayout>
