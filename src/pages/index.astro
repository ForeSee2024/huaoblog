---
// index.astro: 博客主页 (移动端优先文章直现，过滤草稿与未来文章)
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import PostCard from '../components/post/PostCard.astro';
import { getPublishedPosts } from '../utils/posts';
import { sortFeedPosts } from '../utils/post-filters';
import { settings, site } from '../config/site';

const sortedPosts = sortFeedPosts(await getPublishedPosts());
const homePosts = sortedPosts.slice(0, settings.home.postsPerPage);
---
<BaseLayout>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    
    <!-- 左侧常驻侧边栏 (移动端后置显示) -->
    <Sidebar />

    <!-- 右侧主体内容流 (移动端 order-1 优先第一屏呈现) -->
    <main class="w-full lg:flex-1 flex flex-col gap-6 min-w-0 order-1 lg:order-2">
      
      <!-- 主页 Hero 引言卡 -->
      <div class="cyber-card p-6 md:p-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-glass)] border border-[var(--border-subtle)] text-[10px] font-mono text-[var(--accent)] mb-4">
          <span class="pulse-dot"></span>
          <span>{site.brand} / {settings.home.eyebrow}</span>
        </div>

        <h1 class="text-2xl md:text-4xl font-extrabold text-[var(--text-hero)] leading-tight tracking-tight whitespace-pre-line mb-3">{settings.home.title}</h1>

        <p class="text-xs md:text-sm text-[var(--text-muted)] leading-relaxed max-w-2xl mb-6">
          {settings.home.intro}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/posts" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--accent)] text-[var(--accent-contrast)] text-xs font-bold no-underline shadow-[0_0_20px_var(--accent-glow)] hover:opacity-90 transition-opacity">
            <i class="fa-solid fa-book-open"></i>
            <span>{settings.home.primaryLabel}</span>
          </a>
          <a href="/about" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-main)] hover:text-[var(--accent)] text-xs font-bold no-underline hover:border-[var(--accent)] transition-all">
            <i class="fa-solid fa-user-astronaut"></i>
            <span>{settings.home.secondaryLabel}</span>
          </a>
        </div>
      </div>

      <!-- 全站播报通告条 -->
      {settings.home.announcementEnabled && <div class="cyber-card p-3.5 flex items-start gap-3 text-xs">
        <i class="fa-solid fa-bullhorn text-[var(--accent)] text-sm flex-shrink-0" aria-hidden="true"></i>
        <span class="font-bold text-[var(--text-hero)] flex-shrink-0">{settings.home.announcementTitle}：</span>
        <span class="text-[var(--text-muted)] whitespace-pre-line min-w-0 flex-grow">
          {settings.home.announcement}
        </span>
      </div>}

      <!-- 最新发布文章流标题 -->
      <div class="flex items-center justify-between mt-2">
        <div class="flex items-center gap-2 text-sm font-extrabold text-[var(--text-hero)]">
          <i class="fa-solid fa-fire text-[#ef4444]"></i>
          <span>{settings.home.feedTitle}</span>
        </div>
        <a href="/posts" class="text-xs font-semibold text-[var(--accent)] no-underline hover:underline flex items-center gap-1">
          <span>查看全部博文</span>
          <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </a>
      </div>

      <!-- 文章卡片列表 -->
      <div class="flex flex-col gap-4">
        {homePosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>

    </main>

  </div>
</BaseLayout>
