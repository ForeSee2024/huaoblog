---
// 文章按请求读取当前已发布版本，草稿和删除记录不对外展示。
import { getPublishedPost } from '../../utils/posts';
import PostLayout from '../../layouts/PostLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown } from '../../server/render-markdown.js';

const post = await getPublishedPost(Astro.locals.services.store, Astro.params.slug || '');
if (!post) Astro.response.status = 404;
const { html, headings } = post ? renderMarkdown(post.body || '') : { html: '', headings: [] };
---
{post ? <PostLayout post={post} headings={headings}>
  <Fragment set:html={html} />
</PostLayout> : <BaseLayout title="文章不存在">
  <main class="cyber-card p-8 md:p-10">
    <h1 class="text-2xl font-bold text-[var(--text-hero)] mb-3">文章不存在</h1>
    <p class="text-sm text-[var(--text-muted)] mb-5">这篇文章暂未发布，或已被移除。</p>
    <a href="/posts" class="text-sm text-[var(--accent)]">返回文章列表 →</a>
  </main>
</BaseLayout>}
