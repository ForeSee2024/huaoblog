---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import PostCard from '../../components/post/PostCard.astro';
import { getPublishedPosts } from '../../utils/posts';
import { sortFeedPosts } from '../../utils/post-filters';
import { categories } from '../../config/site';
const posts = sortFeedPosts(await getPublishedPosts());
---
<BaseLayout title="技术博文 | HuaOvO · 胡敖的技术笔记">
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <Sidebar />
    <main class="w-full lg:flex-1 flex flex-col gap-6 min-w-0 order-1 lg:order-2">
      <header class="cyber-card p-6">
        <p class="text-xs font-mono text-[var(--accent)] mb-2">KNOWLEDGE / NOTES</p>
        <h1 class="text-2xl font-extrabold text-[var(--text-hero)] mb-4">技术博文专栏</h1>
        <div class="flex flex-wrap gap-2 text-xs" id="category-filter-bar" aria-label="按分类筛选文章">
          {['全部', ...categories].map((name, index) => <button type="button" data-category={index === 0 ? '' : name} aria-pressed={index === 0 ? 'true' : 'false'} class="post-filter">{name}</button>)}
        </div>
        <div id="active-filters" class="flex flex-wrap gap-2 mt-4 text-xs"></div>
        <p id="filter-results-count" class="mt-4 text-xs text-[var(--text-muted)]" role="status">共 {posts.length} 篇文章</p>
      </header>
      <div class="flex flex-col gap-4" id="posts-container">
        {posts.map(post => <div class="post-item-wrap" data-category={post.data.category} data-tags={JSON.stringify(post.data.tags)} data-series={post.data.series || ''}><PostCard post={post} /></div>)}
      </div>
      <div id="posts-empty" class="cyber-card p-10 text-center" hidden>
        <p class="text-[var(--text-hero)] mb-2">暂时没有符合条件的文章</p>
        <button type="button" id="clear-post-filters" class="text-sm text-[var(--accent)] underline">清除筛选，查看全部文章</button>
      </div>
    </main>
  </div>
</BaseLayout>
<script>
  import { matchesPostFilters } from '../../utils/post-filters';
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#category-filter-bar button')];
  const items = [...document.querySelectorAll<HTMLElement>('.post-item-wrap')];
  const active = document.getElementById('active-filters');
  function applyFilters() {
    const params = new URLSearchParams(location.search);
    for (const button of buttons) button.setAttribute('aria-pressed', String((params.get('cat') || '') === button.dataset.category));
    let count = 0;
    for (const item of items) {
      const matches = matchesPostFilters({ category: item.dataset.category || '', tags: JSON.parse(item.dataset.tags || '[]'), series: item.dataset.series }, params);
      item.hidden = !matches;
      if (matches) count++;
    }
    document.getElementById('filter-results-count')!.textContent = `共 ${count} 篇文章`;
    document.getElementById('posts-empty')!.hidden = count !== 0;
    active?.replaceChildren();
    for (const [key, label] of [['tag', '标签'], ['series', '系列']]) {
      const value = params.get(key);
      if (!value || !active) continue;
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'post-filter'; button.textContent = `${label}：${value} · 清除`;
      button.addEventListener('click', () => updateFilter(key, '')); active.append(button);
    }
  }
  function updateFilter(key: string, value: string) {
    const url = new URL(location.href);
    value ? url.searchParams.set(key, value) : url.searchParams.delete(key);
    history.pushState(null, '', url); applyFilters();
  }
  buttons.forEach(button => button.addEventListener('click', () => updateFilter('cat', button.dataset.category || '')));
  document.getElementById('clear-post-filters')?.addEventListener('click', () => {
    const url = new URL(location.href); ['cat', 'tag', 'series'].forEach(key => url.searchParams.delete(key)); history.pushState(null, '', url); applyFilters();
  });
  window.addEventListener('popstate', applyFilters); applyFilters();
</script>
<style>
  .post-filter { min-height: 40px; border: 1px solid var(--border-card); border-radius: 99px; padding: .4rem .85rem; background: var(--bg-glass); color: var(--text-muted); font-weight: 600; cursor: pointer; transition: color 160ms, background 160ms; }
  .post-filter[aria-pressed="true"] { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }
  .post-filter:hover { border-color: var(--accent); }
</style>
