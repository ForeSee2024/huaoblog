---
import { getPublishedPosts } from '../../utils/posts';
const fallback = (await getPublishedPosts()).map(post => ({ title: post.data.title, category: post.data.category, tags: post.data.tags, url: `/posts/${post.slug}/`, excerpt: post.data.description }));
---
<dialog id="site-search" aria-labelledby="search-title" class="cyber-card">
  <header class="search-heading"><h2 id="search-title">搜索文章</h2><button type="button" id="search-close" aria-label="关闭搜索">关闭 <kbd>Esc</kbd></button></header>
  <label class="sr-only" for="search-input">搜索关键词</label>
  <input type="search" id="search-input" placeholder="搜索正文、标题或技术术语…" autocomplete="off" autofocus />
  <p id="search-state" role="status">输入关键词，开始查找文章。</p>
  <div id="search-results-list"></div>
</dialog>
<script type="application/json" id="article-search-data" set:html={JSON.stringify(fallback).replace(/</g, '\\u003c')} />
<script>
  interface SearchItem { url: string; excerpt: string; meta?: { title?: string }; title?: string; category?: string; tags?: string[]; }
  interface Pagefind { init?: () => Promise<void>; search: (query: string) => Promise<{ results: { data: () => Promise<SearchItem> }[] }>; }
  const dialog = document.getElementById('site-search') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results-list')!;
  const status = document.getElementById('search-state')!;
  const fallback: SearchItem[] = JSON.parse(document.getElementById('article-search-data')?.textContent || '[]');
  let enginePromise: Promise<Pagefind | null> | undefined;
  let timer: ReturnType<typeof setTimeout>;
  let revision = 0;
  let previousFocus: HTMLElement | null;
  function loadEngine() {
    return enginePromise ??= (async () => {
      if (import.meta.env.DEV) return null;
      try { const url = '/pagefind/pagefind.js'; const engine = await import(/* @vite-ignore */ url) as Pagefind; await engine.init?.(); return engine; } catch { return null; }
    })();
  }
  function renderResults(items: SearchItem[]) {
    list.replaceChildren();
    for (const item of items) {
      const url = new URL(item.url, location.origin);
      if (url.origin !== location.origin || !['http:', 'https:'].includes(url.protocol)) continue;
      const link = document.createElement('a'); link.href = url.href; link.className = 'search-result';
      const title = document.createElement('strong'); title.textContent = item.meta?.title || item.title || '文章';
      const excerpt = document.createElement('p'); excerpt.textContent = new DOMParser().parseFromString(item.excerpt || '', 'text/html').body.textContent;
      link.append(title, excerpt); list.append(link);
    }
  }
  async function search() {
    const current = ++revision;
    const query = input.value.trim();
    if (!query) { list.replaceChildren(); status.textContent = '输入关键词，开始查找文章。'; return; }
    status.textContent = '正在查找…';
    const engine = await loadEngine();
    let items: SearchItem[];
    let fullText = Boolean(engine);
    try {
      if (engine) { const result = await engine.search(query); items = await Promise.all(result.results.slice(0, 8).map(item => item.data())); }
      else throw new Error('metadata search');
    } catch {
      fullText = false; const keyword = query.toLowerCase();
      items = fallback.filter(item => [item.title, item.category, item.excerpt, ...(item.tags || [])].join(' ').toLowerCase().includes(keyword)).slice(0, 8);
    }
    if (current !== revision || !dialog.open) return;
    renderResults(items); status.textContent = items.length ? `找到 ${items.length} 篇文章 · ${fullText ? '全文检索' : '标题、标签与摘要检索'}` : '暂时没有找到相关内容，试试其他关键词。';
  }
  function openSearch() { previousFocus = document.activeElement as HTMLElement; dialog.showModal(); input.focus(); void loadEngine(); }
  document.getElementById('btn-open-search')?.addEventListener('click', openSearch);
  document.getElementById('search-close')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { revision++; clearTimeout(timer); input.value = ''; list.replaceChildren(); status.textContent = '输入关键词，开始查找文章。'; previousFocus?.focus(); });
  dialog.addEventListener('click', event => { if (event.target === dialog) { const box = dialog.getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close(); } });
  window.addEventListener('keydown', event => {
    if (event.key === 'Escape' && dialog.open) { event.preventDefault(); dialog.close(); return; }
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); dialog.open ? dialog.close() : openSearch(); }
  });
  input.addEventListener('input', () => { revision++; clearTimeout(timer); timer = setTimeout(search, 160); });
</script>
<style>
  dialog { width: min(600px, calc(100vw - 2rem)); max-height: min(600px, calc(100svh - 4rem)); overflow: auto; padding: 1.3rem; margin: 12vh auto auto; background: var(--bg-surface); color: var(--text-main); }
  dialog::backdrop { background: rgb(0 0 0 / .6); backdrop-filter: blur(5px); }
  .search-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .search-heading h2 { font-size: 1rem; font-weight: 700; }
  .search-heading button { min-height: 40px; color: var(--text-muted); font-size: .8rem; }
  input { width: 100%; padding: .85rem 1rem; background: var(--bg-input); border: 1px solid var(--border-card); border-radius: .75rem; color: var(--text-main); font-size: 1rem; }
  #search-state { margin: 1rem 0 .5rem; font-size: .78rem; color: var(--text-muted); }
  :global(.search-result) { display: block; padding: 1rem .5rem; border-bottom: 1px solid var(--border-subtle); color: var(--text-main); text-decoration: none; }
  :global(.search-result:hover) { background: var(--bg-glass); }
  :global(.search-result strong) { font-size: .9rem; color: var(--text-hero); }
  :global(.search-result p) { margin-top: .35rem; font-size: .8rem; color: var(--text-muted); line-height: 1.6; }
</style>
