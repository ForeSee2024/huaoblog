---
// Toast.astro: 全局轻量气泡通知容器
---
<div class="fixed bottom-6 right-6 z-50 flex flex-col gap-2.5 pointer-events-none" id="toast-container"></div>

<script>
  // 挂载全局 showToast 工具方法
  (window as any).showToast = function(title: string, desc: string, iconClass = "fa-solid fa-bell") {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = 'cyber-card pointer-events-auto flex items-center gap-3 px-4 py-3 min-w-[280px] bg-[var(--bg-surface)] border border-[var(--border-card)] shadow-2xl transition-all duration-300 transform translate-y-4 opacity-0';
    toast.innerHTML = `
      <div class="text-lg text-[var(--accent)]"><i class="${iconClass}"></i></div>
      <div>
        <div class="text-xs font-bold text-[var(--text-hero)]">${title}</div>
        <div class="text-[11px] text-[var(--text-dim)]">${desc}</div>
      </div>
    `;

    container.appendChild(toast);

    // 入场动效
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-4', 'opacity-0');
    });

    // 定时离场
    setTimeout(() => {
      toast.classList.add('translate-y-4', 'opacity-0');
      setTimeout(() => toast.remove(), 300);
    }, 3200);
  };
</script>
