---
// ThreeWaveBg.astro: 3D 拓扑引力波浪曲面背景引擎 (支持移动端免加载降级与 prefers-reduced-motion 保护)
---
<canvas id="three-bg-canvas" aria-hidden="true" class="hidden lg:block"></canvas>

<script>
  // 仅在宽屏桌面设备且未开启减少动效模式时按需导入并启动 Three.js
  const shouldEnable3D = () => {
    const isDesktop = window.innerWidth >= 1024;
    const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    return isDesktop && !prefersReducedMotion;
  };

  if (typeof window !== 'undefined' && shouldEnable3D()) {
    // 动态异步加载 Three.js，避免阻塞首屏关键资源
    import('three').then((THREE) => {
      let bgScene: any;
      let bgCamera: any;
      let bgRenderer: any;
      let wavePlaneMesh: any;
      let wavePointsMesh: any;
      let waveGeometry: any;
      let is3dBgEnabled = true;
      let waveTime = 0;
      let mouseWorldPos = { x: 0, y: 0 };

      const GRID_X = 64;
      const GRID_Y = 64;
      const PLANE_WIDTH = 2400;
      const PLANE_HEIGHT = 2400;

      function getThemeAccentHex(): number {
        const accent = document.documentElement.dataset.accent || 'cyberblue';
        const isDark = document.documentElement.dataset.theme === 'dark';
        
        switch (accent) {
          case 'neoncyan':
            return isDark ? 0x34d399 : 0x059669;
          case 'violet':
            return isDark ? 0x818cf8 : 0x6366f1;
          case 'lumine':
            return isDark ? 0xfbbf24 : 0xd97706;
          case 'cyberblue':
          default:
            return isDark ? 0x38bdf8 : 0x0284c7;
        }
      }

      function init() {
        const canvas = document.getElementById('three-bg-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        bgScene = new THREE.Scene();
        bgCamera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 10, 3000);
        bgCamera.position.set(0, -680, 520);
        bgCamera.lookAt(0, 80, 0);

        bgRenderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'low-power' });
        bgRenderer.setSize(window.innerWidth, window.innerHeight);
        bgRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // 统一使用现代 Three.js 标准 PlaneGeometry (非废弃的 PlaneBufferGeometry)
        waveGeometry = new THREE.PlaneGeometry(PLANE_WIDTH, PLANE_HEIGHT, GRID_X - 1, GRID_Y - 1);
        
        const isDark = document.documentElement.dataset.theme === 'dark';
        const currentHex = getThemeAccentHex();

        // 拓扑线框
        const wireMat = new THREE.MeshBasicMaterial({
          color: currentHex,
          wireframe: true,
          transparent: true,
          opacity: isDark ? 0.38 : 0.55
        });
        wavePlaneMesh = new THREE.Mesh(waveGeometry, wireMat);
        bgScene.add(wavePlaneMesh);

        // 拓扑光点
        const pointMat = new THREE.PointsMaterial({
          color: currentHex,
          size: isDark ? 3.0 : 3.6,
          transparent: true,
          opacity: isDark ? 0.75 : 0.65,
          blending: isDark ? THREE.AdditiveBlending : THREE.NormalBlending
        });
        wavePointsMesh = new THREE.Points(waveGeometry, pointMat);
        bgScene.add(wavePointsMesh);

        window.addEventListener('mousemove', (e) => {
          const nx = (e.clientX / window.innerWidth) * 2 - 1;
          const ny = -(e.clientY / window.innerHeight) * 2 + 1;
          mouseWorldPos.x = nx * 500;
          mouseWorldPos.y = ny * 350;
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth < 1024) {
            canvas.style.display = 'none';
            return;
          } else {
            canvas.style.display = 'block';
          }
          bgCamera.aspect = window.innerWidth / window.innerHeight;
          bgCamera.updateProjectionMatrix();
          bgRenderer.setSize(window.innerWidth, window.innerHeight);
        });

        const updateColors = () => {
          if (!wavePlaneMesh || !wavePointsMesh) return;
          const hex = getThemeAccentHex();
          const dark = document.documentElement.dataset.theme === 'dark';
          wavePlaneMesh.material.color.setHex(hex);
          wavePlaneMesh.material.opacity = dark ? 0.38 : 0.55;
          wavePointsMesh.material.color.setHex(hex);
          wavePointsMesh.material.blending = dark ? THREE.AdditiveBlending : THREE.NormalBlending;
          wavePointsMesh.material.opacity = dark ? 0.75 : 0.65;
        };

        window.addEventListener('accent-changed', updateColors);
        window.addEventListener('theme-changed', updateColors);

        function animate() {
          requestAnimationFrame(animate);
          if (!is3dBgEnabled || !waveGeometry || window.innerWidth < 1024) return;

          waveTime += 0.02;
          const pos = waveGeometry.attributes.position;
          const count = pos.count;

          for (let i = 0; i < count; i++) {
            const u = (i % GRID_X) / GRID_X;
            const v = Math.floor(i / GRID_X) / GRID_Y;
            const x = pos.getX(i);
            const y = pos.getY(i);

            const wave1 = Math.sin(u * 9 + waveTime) * 36;
            const wave2 = Math.cos(v * 7 + waveTime * 1.2) * 28;
            const wave3 = Math.sin((u + v) * 5 + waveTime * 0.8) * 22;

            const distToMouse = Math.hypot(x - mouseWorldPos.x, y - mouseWorldPos.y);
            const ripple = Math.max(0, 1 - distToMouse / 450) * Math.sin(distToMouse * 0.05 - waveTime * 4) * 35;

            pos.setZ(i, wave1 + wave2 + wave3 + ripple);
          }

          pos.needsUpdate = true;
          bgRenderer.render(bgScene, bgCamera);
        }

        animate();
      }

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(init);
      } else {
        setTimeout(init, 50);
      }
    });
  }
</script>
