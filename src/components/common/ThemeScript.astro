---
// ThemeScript.astro: 零闪烁系统级主题自适应探测与响应脚本
import { settings } from '../../config/site';
const { theme: defaultTheme, accent: defaultAccent } = settings.appearance;
---
<script is:inline define:vars={{ defaultTheme, defaultAccent }}>
  (function() {
    function savedValue(key) {
      try { return localStorage.getItem(key); } catch { return null; }
    }
    const explicitTheme = () => {
      const saved = savedValue('blog-theme');
      return saved === 'light' || saved === 'dark' ? saved : null;
    };
    const systemPreference = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
    const configuredTheme = defaultTheme === 'system' ? (systemPreference?.matches ? 'dark' : 'light') : defaultTheme;
    const targetTheme = explicitTheme() || configuredTheme;
    document.documentElement.setAttribute('data-theme', targetTheme);

    const savedAccent = savedValue('blog-accent');
    const targetAccent = ['cyberblue', 'neoncyan', 'violet', 'lumine'].includes(savedAccent) ? savedAccent : defaultAccent;
    document.documentElement.setAttribute('data-accent', targetAccent);

    // 仅在站点跟随系统、且访客未保存明暗偏好时同步系统变化。
    if (defaultTheme === 'system' && systemPreference) {
      systemPreference.addEventListener('change', (e) => {
        if (!explicitTheme()) {
          const sysTheme = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', sysTheme);
          window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: sysTheme } }));
        }
      });
    }
  })();
</script>
