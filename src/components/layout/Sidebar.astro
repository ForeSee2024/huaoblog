---
// 常驻侧边栏：个人名片、分类、标签与系列。
import { getPublishedPosts } from '../../utils/posts';
import { safeExternalHref, safeImageSrc, site } from '../../config/site';

const allPosts = await getPublishedPosts();
const totalPosts = allPosts.length;

// 动态统计五大板块分类文章数
const catCountMap: Record<string, number> = {};
allPosts.forEach(post => {
  const cat = post.data.category;
  catCountMap[cat] = (catCountMap[cat] || 0) + 1;
});

const categories = [
  { name: '软件工程与系统', count: catCountMap['软件工程与系统'] || 0, icon: 'fa-solid fa-code', color: '#38bdf8' },
  { name: 'AI 与前沿科研', count: catCountMap['AI 与前沿科研'] || 0, icon: 'fa-solid fa-brain', color: '#a855f7' },
  { name: '极客安全与攻防', count: catCountMap['极客安全与攻防'] || 0, icon: 'fa-solid fa-shield-halved', color: '#ef4444' },
  { name: '计算机体系沉淀', count: catCountMap['计算机体系沉淀'] || 0, icon: 'fa-solid fa-microchip', color: '#10b981' },
  { name: '生活随笔与杂项', count: catCountMap['生活随笔与杂项'] || 0, icon: 'fa-solid fa-feather-pointed', color: '#f59e0b' },
];

// 动态聚合真实标签集合
const tagSet = new Set<string>();
allPosts.forEach(post => {
  (post.data.tags || []).forEach(t => tagSet.add(t));
});
const tags = Array.from(tagSet);
const totalTagsCount = tags.length;
const totalCatsCount = Object.keys(catCountMap).length;
const seriesNames = Array.from(new Set(allPosts.map(post => post.data.series).filter((name): name is string => Boolean(name))));
const socialIcons: Record<string, string> = {
  github: 'fa-brands fa-github', 'fa-brands fa-github': 'fa-brands fa-github',
  gitlab: 'fa-brands fa-gitlab', 'fa-brands fa-gitlab': 'fa-brands fa-gitlab',
  twitter: 'fa-brands fa-x-twitter', 'x-twitter': 'fa-brands fa-x-twitter', 'fa-brands fa-x-twitter': 'fa-brands fa-x-twitter',
  bilibili: 'fa-brands fa-bilibili', 'fa-brands fa-bilibili': 'fa-brands fa-bilibili',
  weibo: 'fa-brands fa-weibo', 'fa-brands fa-weibo': 'fa-brands fa-weibo',
  discord: 'fa-brands fa-discord', 'fa-brands fa-discord': 'fa-brands fa-discord',
  linkedin: 'fa-brands fa-linkedin', 'fa-brands fa-linkedin': 'fa-brands fa-linkedin',
  rss: 'fa-solid fa-rss', 'fa-solid fa-rss': 'fa-solid fa-rss',
  email: 'fa-solid fa-envelope', envelope: 'fa-solid fa-envelope', 'fa-solid fa-envelope': 'fa-solid fa-envelope',
  link: 'fa-solid fa-link', 'fa-solid fa-link': 'fa-solid fa-link',
};
const socialLinks = site.socialLinks.flatMap(link => {
  const url = safeExternalHref(link.url);
  return url ? [{ ...link, url, icon: socialIcons[link.icon || ''] || socialIcons.link }] : [];
});
---
<aside class="w-full lg:w-72 flex flex-col gap-5 flex-shrink-0 order-2 lg:order-1">
  
  <!-- 博主名片卡 -->
  <div class="cyber-card p-6 text-center">
    <!-- 头像容器 -->
    <div class="relative w-24 h-24 mx-auto mb-4">
      <div class="absolute inset-0 rounded-full border-2 border-dashed border-[var(--accent)] animate-[spin_24s_linear_infinite]"></div>
      <img 
        src={safeImageSrc(site.avatar) || '/favicon.svg'}
        alt={`${site.author} 的头像`}
        class="w-full h-full object-cover rounded-full p-1"
        loading="lazy"
      />
    </div>

    <h2 class="text-xl font-extrabold text-[var(--text-hero)] tracking-tight mb-1">{site.brand}</h2>
    <p class="text-xs text-[var(--text-muted)] mb-3">{site.author}</p>
    
    {site.tagline && <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent)] text-xs font-bold mb-3 border border-[var(--border-subtle)]">
      <i class="fa-solid fa-layer-group text-[10px]" aria-hidden="true"></i>
      <span>{site.tagline}</span>
    </div>}

    {site.bio && <p class="text-xs text-[var(--text-muted)] leading-relaxed whitespace-pre-line mb-5">{site.bio}</p>}

    <!-- 动态统计行 -->
    <div class="grid grid-cols-3 py-3 border-y border-[var(--border-subtle)] mb-5">
      <a href="/archive" class="no-underline group">
        <div class="font-mono text-base font-extrabold text-[var(--text-hero)] group-hover:text-[var(--accent)] transition-colors">{totalPosts}</div>
        <div class="text-[10px] font-bold text-[var(--text-dim)] tracking-wider">POSTS</div>
      </a>
      <a href="/archive" class="no-underline group border-x border-[var(--border-subtle)]">
        <div class="font-mono text-base font-extrabold text-[var(--text-hero)] group-hover:text-[var(--accent)] transition-colors">{totalTagsCount}</div>
        <div class="text-[10px] font-bold text-[var(--text-dim)] tracking-wider">TAGS</div>
      </a>
      <a href="/archive" class="no-underline group">
        <div class="font-mono text-base font-extrabold text-[var(--text-hero)] group-hover:text-[var(--accent)] transition-colors">{totalCatsCount}</div>
        <div class="text-[10px] font-bold text-[var(--text-dim)] tracking-wider">CATS</div>
      </a>
    </div>

    <!-- 社交连接 -->
    {socialLinks.length > 0 && <div class="flex flex-wrap items-center justify-center gap-2">
      {socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full flex items-center justify-center bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors" title={link.label} aria-label={link.label}>
        <i class={`${link.icon} text-sm`} aria-hidden="true"></i>
      </a>)}
    </div>}
  </div>

  <!-- 五大标准知识体系分类卡片 (真实聚合统计) -->
  <div class="cyber-card p-5">
    <div class="flex items-center gap-2 text-sm font-extrabold text-[var(--text-hero)] mb-3 pb-2 border-b border-[var(--border-subtle)]">
      <i class="fa-solid fa-folder-tree text-[var(--accent)]"></i>
      <span>知识体系分类</span>
    </div>
    <div class="flex flex-col gap-1.5">
      {categories.map(cat => (
        <a href={`/posts?cat=${encodeURIComponent(cat.name)}`} class="flex items-center justify-between p-2 rounded-xl hover:bg-[var(--bg-glass)] transition-colors group no-underline">
          <span class="flex items-center gap-2.5 text-xs font-semibold text-[var(--text-main)] group-hover:text-[var(--accent)] transition-colors">
            <i class={cat.icon} style={`color: ${cat.color};`}></i>
            <span>{cat.name}</span>
          </span>
          <span class="font-mono text-xs font-bold text-[var(--text-dim)]">{cat.count}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- 技术与科研标签云卡片 (真实文章提取) -->
  <div class="cyber-card p-5">
    <div class="flex items-center gap-2 text-sm font-extrabold text-[var(--text-hero)] mb-3 pb-2 border-b border-[var(--border-subtle)]">
      <i class="fa-solid fa-tags text-[var(--accent)]"></i>
      <span>技术与研究标签</span>
    </div>
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => (
        <a href={`/posts?tag=${encodeURIComponent(tag)}`} class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all no-underline">
          {tag}
        </a>
      ))}
    </div>
  </div>

  {seriesNames.length > 0 && <div class="cyber-card p-5">
    <h2 class="text-sm font-extrabold text-[var(--text-hero)] mb-3">连载系列</h2>
    <div class="flex flex-col gap-2">
      {seriesNames.map(name => <a href={`/posts?series=${encodeURIComponent(name)}`} class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] no-underline">{name}</a>)}
    </div>
  </div>}
</aside>
