---
// Sidebar.astro: Kira 风格常驻侧边栏 (个人名片、五大标准分类、标签云)
interface Props {
  totalPosts?: number;
}
const { totalPosts = 68 } = Astro.props;

const categories = [
  { name: '软件工程与系统', count: 22, icon: 'fa-solid fa-code', color: '#38bdf8' },
  { name: 'AI 与前沿科研', count: 14, icon: 'fa-solid fa-brain', color: '#a855f7' },
  { name: '极客安全与攻防', count: 18, icon: 'fa-solid fa-shield-halved', color: '#ef4444' },
  { name: '计算机体系沉淀', count: 11, icon: 'fa-solid fa-microchip', color: '#10b981' },
  { name: '生活随笔与杂项', count: 8, icon: 'fa-solid fa-feather-pointed', color: '#f59e0b' },
];

const tags = [
  'Rust', '大语言模型', 'Linux内核', 'Three.js', 
  'Astro 5', 'Shiro反序列化', 'eBPF', '分布式系统', '极客生产力'
];
---
<aside class="w-full lg:w-72 flex flex-col gap-5 flex-shrink-0 order-2 lg:order-1">
  
  <!-- 博主名片卡 -->
  <div class="cyber-card p-6 text-center">
    <!-- 头像容器 -->
    <div class="relative w-24 h-24 mx-auto mb-4">
      <div class="absolute inset-0 rounded-full border-2 border-dashed border-[var(--accent)] animate-[spin_24s_linear_infinite]"></div>
      <img 
        src="https://images.unsplash.com/photo-1578632767115-351597cf2477?w=300&auto=format&fit=crop&q=80" 
        alt="Kael Avatar" 
        class="w-full h-full object-cover rounded-full p-1"
        loading="lazy"
      />
    </div>

    <h2 class="text-xl font-extrabold text-[var(--text-hero)] tracking-tight mb-1">Kael_Dev</h2>
    
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent)] text-xs font-bold mb-3 border border-[var(--border-subtle)]">
      <i class="fa-solid fa-layer-group text-[10px]"></i>
      <span>Fullstack • AI • Security</span>
    </div>

    <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-5">
      用工程构建秩序，以好奇探索未知<br/>
      <span class="text-[var(--text-dim)]">全栈开发 • 学术科研 • 攻防实战</span>
    </p>

    <!-- 统计行 -->
    <div class="grid grid-cols-3 py-3 border-y border-[var(--border-subtle)] mb-5">
      <a href="/archive" class="no-underline group">
        <div class="font-mono text-base font-extrabold text-[var(--text-hero)] group-hover:text-[var(--accent)] transition-colors">{totalPosts}</div>
        <div class="text-[10px] font-bold text-[var(--text-dim)] tracking-wider">POSTS</div>
      </a>
      <a href="/archive" class="no-underline group border-x border-[var(--border-subtle)]">
        <div class="font-mono text-base font-extrabold text-[var(--text-hero)] group-hover:text-[var(--accent)] transition-colors">26</div>
        <div class="text-[10px] font-bold text-[var(--text-dim)] tracking-wider">TAGS</div>
      </a>
      <a href="/archive" class="no-underline group">
        <div class="font-mono text-base font-extrabold text-[var(--text-hero)] group-hover:text-[var(--accent)] transition-colors">5</div>
        <div class="text-[10px] font-bold text-[var(--text-dim)] tracking-wider">CATS</div>
      </a>
    </div>

    <!-- 社交连接 -->
    <div class="flex items-center justify-center gap-2">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full flex items-center justify-center bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors" title="GitHub">
        <i class="fa-brands fa-github text-sm"></i>
      </a>
      <a href="https://bilibili.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full flex items-center justify-center bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors" title="Bilibili">
        <i class="fa-brands fa-bilibili text-sm"></i>
      </a>
      <a href="https://t.me" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full flex items-center justify-center bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors" title="Telegram">
        <i class="fa-brands fa-telegram text-sm"></i>
      </a>
      <a href="mailto:kael@nexus.sec" class="w-8 h-8 rounded-full flex items-center justify-center bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors" title="Email">
        <i class="fa-solid fa-envelope text-sm"></i>
      </a>
    </div>
  </div>

  <!-- 五大标准知识体系分类卡片 -->
  <div class="cyber-card p-5">
    <div class="flex items-center gap-2 text-sm font-extrabold text-[var(--text-hero)] mb-3 pb-2 border-b border-[var(--border-subtle)]">
      <i class="fa-solid fa-folder-tree text-[var(--accent)]"></i>
      <span>知识体系分类</span>
    </div>
    <div class="flex flex-col gap-1.5">
      {categories.map(cat => (
        <a href={`/posts?cat=${encodeURIComponent(cat.name)}`} class="flex items-center justify-between p-2 rounded-xl hover:bg-[var(--bg-glass)] transition-colors group no-underline">
          <span class="flex items-center gap-2.5 text-xs font-semibold text-[var(--text-main)] group-hover:text-[var(--accent)] transition-colors">
            <i class={cat.icon} style={`color: ${cat.color};`}></i>
            <span>{cat.name}</span>
          </span>
          <span class="font-mono text-xs font-bold text-[var(--text-dim)]">{cat.count}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- 技术与科研标签云卡片 -->
  <div class="cyber-card p-5">
    <div class="flex items-center gap-2 text-sm font-extrabold text-[var(--text-hero)] mb-3 pb-2 border-b border-[var(--border-subtle)]">
      <i class="fa-solid fa-tags text-[var(--accent)]"></i>
      <span>技术与研究标签</span>
    </div>
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => (
        <a href={`/posts?tag=${encodeURIComponent(tag)}`} class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all no-underline">
          {tag}
        </a>
      ))}
    </div>
  </div>

</aside>
