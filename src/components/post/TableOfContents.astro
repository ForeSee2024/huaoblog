---
// TableOfContents.astro: 轻盈侧翼章节导轨 (仅在存在章节时展示，纯容器内部滚动绝不劫持页面滚动)
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth <= 3);
---
{filteredHeadings.length > 0 && (
  <aside class="post-reading-rail-right hidden xl:block" aria-label="文章章节导轨">
    <div class="toc-rail">
      <div class="toc-rail-head">
        <span class="toc-rail-title">
          <i class="fa-solid fa-bars-staggered text-[var(--accent)] text-[11px]" aria-hidden="true"></i>
          <span>本文目录</span>
        </span>
        <span id="reading-percent" class="toc-rail-percent">0%</span>
      </div>
      <div class="toc-rail-progress" aria-hidden="true">
        <div id="toc-progress-bar" class="toc-rail-progress-fill"></div>
      </div>

      <ul id="desktop-toc-list" class="toc-rail-list">
        {filteredHeadings.map(h => (
          <li class:list={[h.depth === 3 ? 'is-sub' : 'is-main']}>
            <a
              href={`#${h.slug}`}
              data-toc-slug={h.slug}
              class="toc-link"
              title={h.text}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
)}

<script>
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('#desktop-toc-list a[data-toc-slug]')];
  const headingNodes = tocLinks
    .map(link => document.getElementById(link.dataset.tocSlug || ''))
    .filter((node): node is HTMLElement => Boolean(node));

  let activeSlug = '';

  function updateProgressAndSpy() {
    const scrollY = window.scrollY;
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const rawProgress = totalHeight > 0 ? (scrollY / totalHeight) * 100 : 0;
    const progress = totalHeight - scrollY <= 6 && totalHeight > 0
      ? 100
      : Math.min(100, Math.max(0, rawProgress));

    const bar = document.getElementById('toc-progress-bar');
    const laser = document.getElementById('reading-laser-bar');
    const percent = document.getElementById('reading-percent');
    if (bar) bar.style.width = `${progress}%`;
    if (laser) laser.style.width = `${progress}%`;
    if (percent) percent.textContent = `${Math.round(progress)}%`;

    if (!headingNodes.length) return;
    const offset = 136;
    let current = headingNodes[0].id;
    if (totalHeight > 0 && totalHeight - scrollY <= 12) {
      current = headingNodes[headingNodes.length - 1].id;
    } else {
      for (const heading of headingNodes) {
        if (heading.getBoundingClientRect().top - offset <= 0) {
          current = heading.id;
        } else {
          break;
        }
      }
    }

    if (current !== activeSlug) {
      activeSlug = current;
      const tocList = document.getElementById('desktop-toc-list');
      for (const link of tocLinks) {
        const matched = link.dataset.tocSlug === current;
        link.classList.toggle('is-active', matched);
        // 仅在侧边目录可见且自身产生溢出时调整内部 scrollTop，绝不调用 scrollIntoView 避免页面跳回顶部
        if (matched && tocList && tocList.offsetParent !== null && tocList.scrollHeight > tocList.clientHeight) {
          const targetTop = link.offsetTop - tocList.offsetTop - (tocList.clientHeight / 2) + (link.clientHeight / 2);
          tocList.scrollTop = Math.max(0, targetTop);
        }
      }
    }
  }

  window.addEventListener('scroll', updateProgressAndSpy, { passive: true });
  window.addEventListener('resize', updateProgressAndSpy);
  updateProgressAndSpy();
</script>
