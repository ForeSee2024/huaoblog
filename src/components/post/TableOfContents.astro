---
// TableOfContents.astro: 自适应文章目录与实时章节高亮 (ScrollSpy)
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth <= 3);
---
<aside class="hidden xl:block w-64 flex-shrink-0">
  <div class="sticky top-24 cyber-card p-4">
    <div class="flex items-center justify-between text-xs font-bold text-[var(--text-hero)] pb-2.5 mb-3 border-b border-[var(--border-subtle)]">
      <span class="flex items-center gap-2">
        <i class="fa-solid fa-list-ul text-[var(--accent)]" aria-hidden="true"></i>
        <span>文章目录</span>
      </span>
      <span class="font-mono text-[10px] text-[var(--text-dim)]">{filteredHeadings.length} 节</span>
    </div>

    {filteredHeadings.length > 0 ? (
      <ul id="desktop-toc-list" class="flex flex-col gap-1 text-xs max-h-[62vh] overflow-y-auto pr-1">
        {filteredHeadings.map(h => (
          <li class:list={[h.depth === 3 ? 'pl-3.5 text-[11px]' : 'font-semibold']}>
            <a
              href={`#${h.slug}`}
              data-toc-slug={h.slug}
              class="toc-link block py-1.5 px-2.5 rounded-lg border-l-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-glass)] transition-all no-underline truncate"
              title={h.text}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-xs text-[var(--text-dim)] py-2">本文无多级章节目录</p>
    )}

    <!-- 阅读进度条 -->
    <div class="mt-4 pt-3 border-t border-[var(--border-subtle)]">
      <div class="flex justify-between items-center text-[10px] font-mono text-[var(--text-dim)] mb-1.5">
        <span>READING PROGRESS</span>
        <span id="reading-percent" class="text-[var(--accent)] font-semibold">0%</span>
      </div>
      <div class="w-full h-1.5 bg-[var(--bg-glass)] rounded-full overflow-hidden">
        <div id="toc-progress-bar" class="w-0 h-full bg-[var(--accent)] rounded-full transition-all duration-150"></div>
      </div>
    </div>
  </div>
</aside>

<style>
  .toc-link.is-active {
    color: var(--accent);
    background: var(--accent-soft);
    border-left-color: var(--accent);
    font-weight: 700;
  }
</style>

<script>
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('#desktop-toc-list a[data-toc-slug]')];
  const headingNodes = tocLinks
    .map(link => document.getElementById(link.dataset.tocSlug || ''))
    .filter((node): node is HTMLElement => Boolean(node));

  let activeSlug = '';

  function updateProgressAndSpy() {
    const scrollY = window.scrollY;
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = totalHeight > 0 ? Math.min(100, Math.max(0, (scrollY / totalHeight) * 100)) : 0;

    const bar = document.getElementById('toc-progress-bar');
    const laser = document.getElementById('reading-laser-bar');
    const percent = document.getElementById('reading-percent');
    if (bar) bar.style.width = `${progress}%`;
    if (laser) laser.style.width = `${progress}%`;
    if (percent) percent.innerText = `${Math.round(progress)}%`;

    if (!headingNodes.length) return;
    const offset = 128;
    let current = headingNodes[0].id;
    for (const heading of headingNodes) {
      if (heading.getBoundingClientRect().top - offset <= 0) {
        current = heading.id;
      } else {
        break;
      }
    }
    if (current !== activeSlug) {
      activeSlug = current;
      for (const link of tocLinks) {
        const matched = link.dataset.tocSlug === current;
        link.classList.toggle('is-active', matched);
        if (matched) link.scrollIntoView({ block: 'nearest' });
      }
    }
  }

  window.addEventListener('scroll', updateProgressAndSpy, { passive: true });
  window.addEventListener('resize', updateProgressAndSpy);
  updateProgressAndSpy();
</script>
